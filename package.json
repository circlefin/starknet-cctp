{
  "name": "starknet-cctp-private",
  "packageManager": "yarn@4.6.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@jest/globals": "^30.0.4",
    "@noble/secp256k1": "^2.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.2.0",
    "commander": "^14.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.4",
    "ethers": "^6.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "readline": "^1.3.0",
    "starknet": "^8.5.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "yup": "^1.7.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build-contracts": "scarb build --workspace && cd stablecoin-starknet-private && scarb build --workspace",
    "start-network": "bash ./e2e/cmd/start_network.sh",
    "stop-network": "bash ./e2e/cmd/stop_network.sh",
    "deploy": "tsx ./e2e/cmd/deploy.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "test:e2e": "bash ./e2e/cmd/run-e2e-tests.sh",
    "scripts": "tsx ./scripts/index.ts",
    "release": "scarb --profile release build --workspace"
  }
}
